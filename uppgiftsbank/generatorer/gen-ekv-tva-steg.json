{
  "id": "gen-ekv-tva-steg",
  "namn": "Ekvationer i två steg",
  "kategori": "algebra/ekvationer/tva-steg",
  "typ": "grupp",
  "instruktion": "Lös ekvationerna.",
  "arskurs": [
    8,
    9
  ],
  "svarighet": 2,
  "taggar": [
    "rutin"
  ],
  "parametrar": {
    "a": {
      "valj": [
        2,
        3,
        4,
        5,
        6,
        7,
        8,
        9
      ]
    },
    "x": {
      "heltal": [
        "-6",
        "10"
      ]
    },
    "b": {
      "heltal": [
        "-9",
        "9"
      ]
    },
    "c": {
      "uttryck": "a*x+b"
    }
  },
  "villkor": [
    "b!=0"
  ],
  "text": "{a}x {sym(b)} {abs(b)} = {n(c)}",
  "facit": "x = {n(x)}"
}
